{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cltristes/campusos",
    "type": "project",
    "description": "CampusOS — gestao da graduacao (progressao, pre-requisitos, horas) e acervo academico compartilhado entre veteranos e calouros. Laravel 12 modular, multi-tenant por instituicao.",
    "keywords": [
        "laravel",
        "template",
        "modular-monolith",
        "ai-oriented"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "internachi/modular": "^3.0",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.47",
        "laravel/tinker": "^2.10.1",
        "predis/predis": "^3.5",
        "campus-os/core": "*",
        "campus-os/tenancy": "*",
        "campus-os/catalog": "*",
        "campus-os/journey": "*",
        "campus-os/lifeos": "*",
        "campus-os/insights": "*",
        "campus-os/integrations": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "knuckleswtf/scribe": "^5.11",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi",
            "@php -d memory_limit=1G vendor/pestphp/pest/bin/pest --coverage --min=70"
        ],
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "docs": "@php artisan scribe:generate"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "ext-pcntl": "8.2",
            "ext-posix": "8.2"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "app-modules": {
            "type": "path",
            "url": "app-modules/*",
            "options": {
                "symlink": true
            }
        }
    }
}
