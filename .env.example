APP_NAME="CampusOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# BANCO — quickstart: sqlite (zero infra). PADRÃO DE PRODUÇÃO: PostgreSQL 16
# próprio (compose.yaml sobe um local). Sem Postgres-as-a-service.
# Descomente o bloco pgsql e comente o sqlite quando subir o docker compose.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=campusos
DB_USERNAME=campusos
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# FILAS — quickstart: database (zero infra). PADRÃO DE PRODUÇÃO: redis (com
# Horizon nos workers Linux; no Windows dev use `php artisan queue:work`).
# Filas nomeadas por prioridade de negócio (ex.: orders) — ver config/horizon.php.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis (client PHP puro — sem extensão nativa; troque para phpredis se a tiver)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Leitura de documentos acadêmicos (histórico, requerimento, matriz)
# ---------------------------------------------------------------------------
# O provedor é uma decisão de UM lugar só: o bind em
# app-modules/integrations/src/Providers/IntegrationsServiceProvider.php.
# 'gemini' usa a camada gratuita do Google AI Studio — chave em
# https://aistudio.google.com/apikey
# 'null' desliga a leitura automática e manda tudo para a tela de conferência
# (é o plano B da demonstração, e o que roda nos testes).
DOCUMENT_EXTRACTOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
