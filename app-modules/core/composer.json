{
	"name": "campus-os/core",
	"description": "Shared kernel: infraestrutura cross-módulo pura (tenancy, auditoria, actions, contratos de fronteira). Não contém regra de negócio.",
	"type": "library",
	"version": "1.0",
	"license": "proprietary",
	"require": {},
	"autoload": {
		"psr-4": {
			"CampusOs\\Core\\": "src/",
			"CampusOs\\Core\\Tests\\": "tests/",
			"CampusOs\\Core\\Database\\Factories\\": "database/factories/",
			"CampusOs\\Core\\Database\\Seeders\\": "database/seeders/"
		}
	},
	"minimum-stability": "stable",
	"extra": {
		"laravel": {
			"providers": [
				"CampusOs\\Core\\Providers\\CoreServiceProvider"
			]
		}
	}
}
